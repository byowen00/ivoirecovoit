# Configuration d'un déploiement d'IvoireCovoit (docker-compose.prod.yml). Copier en infrastructure/.env.prod,
# remplir, puis ajouter les secrets : bash infrastructure/generer-secrets.sh >> infrastructure/.env.prod
# Ce fichier d'exemple ne contient AUCUN secret. Le vrai fichier .env.prod ne doit jamais être commité
# (il est ignoré par git) : le garder sur le serveur, lisible par root seulement (chmod 600).

# --- Mode
# staging = PRÉ-PRODUCTION : codes de connexion de test (OTP_TEST_MODE=true) et paiements simulés (sandbox),
#           données de test uniquement.
# production = refusé par l'API tant qu'un fournisseur SMS et un agrégateur de paiement réels ne sont pas
#           intégrés (voir docs/avant-production.md).
NODE_ENV=staging
OTP_TEST_MODE=true
PAYMENT_PROVIDER=sandbox
SMS_PROVIDER=none
PUSH_PROVIDER=none

# --- Domaines (enregistrements DNS A/AAAA vers le serveur, avant le premier démarrage)
WEB_DOMAIN=preprod.exemple.ci
API_DOMAIN=api.preprod.exemple.ci
# Seulement avec le profil « storage » (documents stockés sur ce serveur)
FILES_DOMAIN=fichiers.preprod.exemple.ci
# Adresse de contact pour Let's Encrypt (expiration des certificats)
ACME_EMAIL=exploitation@exemple.ci
# Essai local sans domaine public : CADDY_TLS=tls internal (et des domaines en .localhost)
CADDY_TLS=

# --- Base de données
POSTGRES_USER=ivoirecovoit
POSTGRES_DB=ivoirecovoit
# Mémoire de PostgreSQL : environ 25 % et 75 % de la mémoire du serveur (valeurs pour 2 Go).
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
DATABASE_POOL_MAX=20

# --- Stockage des documents (S3)
# Sur ce serveur (profil « storage ») : laisser S3_ENDPOINT vide ; les URL signées passent par FILES_DOMAIN.
# Service S3 externe : S3_ENDPOINT=https://... et S3_PUBLIC_ENDPOINT=https://... (HTTPS obligatoire).
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=ivoirecovoit-documents
S3_ACCESS_KEY=ivoirecovoit

# --- Fond de carte du site (pris en compte à la construction de l'image web). Vide = tuiles openstreetmap.org,
# INTERDITES pour une application en production (politique d'usage d'OSM) : prendre un fournisseur sous contrat.
# Exemple : TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=<clé>
TILE_URL=
TILE_ATTRIBUTION=

# --- Routage (profil « routing ») : OSRM_URL=http://osrm:5000 ; vide = estimations à vol d'oiseau
OSRM_URL=

# --- Notifications sur le téléphone (non essayé : projet Firebase à créer)
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_B64=

# --- Sauvegardes
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=7
# Profil « offsite » : destination rclone, ex. stockage:ivoirecovoit-sauvegardes
RCLONE_DESTINATION=
OFFSITE_EVERY_HOURS=6

# --- Images (vide = construites sur le serveur depuis le dépôt)
# BACKEND_IMAGE=ghcr.io/byowen00/ivoirecovoit-backend:<version>
# WEB_IMAGE=ghcr.io/byowen00/ivoirecovoit-web:<version>
