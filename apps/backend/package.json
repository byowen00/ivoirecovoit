{
  "name": "@ivoirecovoit/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/database/seeds/run-seed.ts reference",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/database/seeds/run-seed.ts demo",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:seed:prod": "node dist/database/seeds/run-seed.js reference",
    "staff:create": "tsx --env-file-if-exists=../../.env src/scripts/create-staff.ts",
    "staff:create:prod": "node dist/scripts/create-staff.js",
    "keys:generate": "tsx src/scripts/generate-jwt-keys.ts",
    "storage:init": "tsx --env-file-if-exists=../../.env src/scripts/init-storage.ts",
    "storage:init:prod": "node dist/scripts/init-storage.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "kysely": "^0.28.18",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
