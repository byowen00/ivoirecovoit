# Copier ce fichier en .env (jamais commité) et adapter les valeurs.
# Aucune valeur ci-dessous n'est un vrai secret : ce sont des valeurs de développement local.

# --- Général
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# --- Base de données (docker compose)
POSTGRES_USER=ivoirecovoit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ivoirecovoit
# Port de PostgreSQL sur l'ordinateur si 5432 est déjà pris (par exemple 15432) ; changer aussi les deux URL ci-dessous.
# POSTGRES_HOST_PORT=15432
DATABASE_URL=postgres://ivoirecovoit:change-me-local-only@localhost:5432/ivoirecovoit
DATABASE_POOL_MAX=10
# Base utilisée par les tests d'intégration (recréée à chaque exécution)
TEST_DATABASE_URL=postgres://ivoirecovoit:change-me-local-only@localhost:5432/ivoirecovoit_test

# --- Redis
REDIS_URL=redis://localhost:6379

# --- Documentation OpenAPI (/api/docs), jamais en production
SWAGGER_ENABLED=true

# --- Authentification (étape 5)
# Mode OTP de test : aucun SMS n'est envoyé, le code apparaît dans les logs de l'API et dans la réponse
# (champ testCode). Le serveur REFUSE de démarrer si true en production.
OTP_TEST_MODE=true
# Connexion rapide pour les essais (mode test seulement) : plus de délai ni de plafond de demandes de code,
# et le site et l'appli valident le code tout seuls. Mettre false pour retrouver le parcours normal.
OTP_TEST_QUICK_LOGIN=true
# Secrets (32 caractères minimum). Laissés vides hors production, une valeur de développement publique est
# utilisée ; la production refuse de démarrer sans de vraies valeurs (gestionnaire de secrets).
# OTP_HMAC_SECRET=
# REFRESH_TOKEN_PEPPER=
# STAFF_TOTP_ENCRYPTION_KEY=
# Clés Ed25519 PEM des jetons d'accès. Vides hors production : paire éphémère à chaque démarrage.
# Générer : pnpm --filter @ivoirecovoit/backend keys:generate
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Fournisseur SMS : aucun n'est intégré pour l'instant (contrat et identifiant d'expéditeur à obtenir).
SMS_PROVIDER=none
# Nombre de proxys de confiance devant l'API (0 en local).
TRUST_PROXY=0

# --- Paiement (étape 8)
# sandbox = bac à sable interne, aucun argent réel, REFUSÉ en production.
# aggregator = squelette d'adaptateur, PAS ENCORE INTÉGRÉ : le serveur refuse de démarrer avec cette valeur
# tant qu'un agrégateur (contrat, accès, documentation) n'a pas été choisi et intégré.
PAYMENT_PROVIDER=sandbox
# Secret de signature des webhooks du bac à sable (32 caractères minimum ; valeur de développement par défaut).
# SANDBOX_WEBHOOK_SECRET=
# Adresse de l'application web (retour après la page de paiement simulée).
WEB_BASE_URL=http://localhost:3001

# --- Notifications sur le téléphone (étape 9)
# none = notifications dans l'application seulement. fcm = Firebase Cloud Messaging, écrit d'après la documentation
# mais JAMAIS ESSAYÉ avec un vrai projet : à valider avant la mise en service. Les deux valeurs ci-dessous sont
# alors obligatoires (compte de service JSON encodé en base64, à garder hors du dépôt).
PUSH_PROVIDER=none
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_B64=

# --- Stockage des documents (étape 6, profil docker « storage »)
S3_ENDPOINT=http://localhost:9000
# Adresse utilisée pour signer les URL données aux applications (HTTPS obligatoire en production).
# Sur un téléphone Android en émulateur : http://10.0.2.2:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=ivoirecovoit-documents
S3_ACCESS_KEY=ivoirecovoit
S3_SECRET_KEY=change-me-local-only-min-8-chars
# Secret (32 caractères minimum) de chiffrement des données sensibles (n° de permis). Vide hors production.
# PII_ENCRYPTION_KEY=

# --- Cartographie et routage (étape 6)
# Vide = pas d'OSRM : distances et durées estimées à vol d'oiseau, signalées comme estimations.
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_MS=4000
# TILE_SERVER_URL=
# TILE_API_KEY=

# --- Web (Next.js)
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
# Origine du stockage autorisée par la politique de sécurité du contenu du site (dépôt direct des documents)
CSP_CONNECT_SRC=http://localhost:9000
