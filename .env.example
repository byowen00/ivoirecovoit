# Copier ce fichier en .env (jamais commité) et adapter les valeurs.
# Aucune valeur ci-dessous n'est un vrai secret : ce sont des valeurs de développement local.

# --- Général
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# --- Base de données (docker compose)
POSTGRES_USER=ivoirecovoit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ivoirecovoit
DATABASE_URL=postgres://ivoirecovoit:change-me-local-only@localhost:5432/ivoirecovoit
DATABASE_POOL_MAX=10
# Base utilisée par les tests d'intégration (recréée à chaque exécution)
TEST_DATABASE_URL=postgres://ivoirecovoit:change-me-local-only@localhost:5432/ivoirecovoit_test

# --- Redis
REDIS_URL=redis://localhost:6379

# --- Documentation OpenAPI (/api/docs), jamais en production
SWAGGER_ENABLED=true

# --- Authentification (étape 5)
# Mode OTP de test : code affiché dans les logs. Le serveur REFUSE de démarrer si true en production.
OTP_TEST_MODE=true
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# OTP_HMAC_SECRET=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=

# --- Paiement (étape 8)
# sandbox = simulateur interne, REFUSÉ en production. aggregator = prestataire réel (contrat requis).
PAYMENT_PROVIDER=sandbox
# PAYMENT_API_KEY=
# PAYMENT_SITE_ID=
# PAYMENT_WEBHOOK_SECRET=
# SANDBOX_WEBHOOK_SECRET=

# --- Stockage des documents (étape 6, profil docker « storage »)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_DOCUMENTS=ivoirecovoit-documents
S3_ACCESS_KEY=ivoirecovoit
S3_SECRET_KEY=change-me-local-only-min-8-chars

# --- Cartographie et routage (étape 6)
OSRM_URL=http://localhost:5000
# TILE_SERVER_URL=
# TILE_API_KEY=

# --- Notifications push (étape 9)
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=

# --- Web (Next.js)
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
